<% content_for :title, "Pixels" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Pixels</h1>
  <%= link_to "New pixel", new_pixel_path, class: "bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-4 py-2 rounded-md" %>
</div>

<div class="bg-white border border-slate-200 rounded-lg divide-y divide-slate-100">
  <% if @pixels.empty? %>
    <p class="p-4 text-slate-400 text-sm">No pixels yet.</p>
  <% end %>
  <% @pixels.each do |pixel| %>
    <div class="p-4 flex items-center justify-between">
      <div>
        <div class="font-medium"><%= pixel.name %></div>
        <div class="text-xs text-slate-400 font-mono"><%= pixel.public_id %></div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs px-2 py-0.5 rounded-full <%= pixel.active? ? "bg-green-50 text-green-600" : "bg-slate-100 text-slate-500" %>">
          <%= pixel.active? ? "Active" : "Inactive" %>
        </span>
        <%= link_to "View", pixel_path(pixel), class: "text-blue-600 text-sm hover:underline" %>
      </div>
    </div>
  <% end %>
</div>
