<%= form_with model: pixel, class: "space-y-4 max-w-xl" do |f| %>
  <% if pixel.errors.any? %>
    <div class="bg-red-50 text-red-600 text-sm rounded-md p-3">
      <%= pixel.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Allowed landing pages (one per line)</label>
    <textarea name="pixel[allowed_landing_pages_text]" rows="4"
      class="block w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-sm"><%= pixel.allowed_landing_pages.join("\n") %></textarea>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, class: "text-sm text-slate-700" %>
  </div>

  <%= f.submit (pixel.persisted? ? "Save changes" : "Create pixel"), class: "bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium px-4 py-2 rounded-md cursor-pointer" %>
<% end %>
